      "title": "BME280 & SDS011 Data Visualization",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ClickHouse"
          },
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT \n    timestamp AS time,\n    humidity,\n    temperature,\n    pm10,\n    pm25\nFROM sensor_storage.combined_data\nWHERE location = '$location' AND $__timeFilter(timestamp)\nORDER BY timestamp ASC\nSETTINGS use_query_cache = 0",
          "refId": "A"
        }
