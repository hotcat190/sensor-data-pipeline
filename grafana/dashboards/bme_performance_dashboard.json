      "title": "Top 10 Hottest Locations (Average)",
      "type": "table",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ClickHouse"
          },
          "format": 0,
          "queryType": "sql",
          "rawSql": "SELECT \n    location, \n    round(avg(temperature), 2) AS avg_temperature, \n    round(avg(humidity), 2) AS avg_humidity \nFROM sensor_storage.combined_data \nWHERE $__timeFilter(timestamp) AND temperature > 0\nGROUP BY location \nORDER BY avg_temperature DESC \nLIMIT 10 \nSETTINGS use_query_cache = 0",
          "refId": "A"
        }
      ]
    }
