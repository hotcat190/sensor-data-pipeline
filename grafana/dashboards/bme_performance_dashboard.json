      "title": "Sustained Dangerous PM2.5 (>50 µg/m³)",
      "type": "table",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ClickHouse"
          },
          "format": 0,
          "queryType": "sql",
          "rawSql": "SELECT timestamp, pm25 FROM (\n    SELECT \n        timestamp, \n        pm25, \n        lead(pm25, 1) OVER (ORDER BY timestamp ASC) as next_1, \n        lead(pm25, 2) OVER (ORDER BY timestamp ASC) as next_2 \n    FROM sensor_storage.combined_data \n    WHERE location = '$location' AND $__timeFilter(timestamp)\n) \nWHERE pm25 > 150 AND next_1 > 150 AND next_2 > 150 \nORDER BY timestamp DESC \nLIMIT 20 \nSETTINGS use_query_cache = 0",
          "refId": "A"
        }
      ]
    },
